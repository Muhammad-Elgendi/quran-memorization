# Backend
HOST=0.0.0.0
PORT=8000
QURAN_PATH=data/quran.json
DEFAULT_THRESHOLD=0.85
WORD_MATCH_THRESHOLD=0.75
MIN_AUDIO_SECONDS=0.5
MAX_AUDIO_SECONDS=20.0
MOONSHINE_MODEL=UsefulSensors/moonshine-tiny-ar
CORS_ORIGINS=*

# STT weights: Compose volume hf_cache / K8s PVC hf-model-cache.
# Compose and K8s prefetch automatically; set 1 for bare `docker run`.
# PREFETCH_MODEL=1
# HF_HOME=/models/huggingface
# HF_HUB_CACHE=/models/huggingface/hub

# Phase 2 realtime stream (lightweight defaults)
STREAM_PARTIALS_DEFAULT=true
STREAM_PARTIAL_EVERY_MS=2000
STREAM_SILENCE_MS=800
STREAM_MIN_UTTERANCE_MS=400
# STREAM_COVERAGE_STABLE_TICKS=2
# STREAM_STT_RMS_THRESHOLD=0.008
STREAM_IDLE_TIMEOUT_S=60
STREAM_MAX_SESSION_S=1800
STREAM_MAX_CONCURRENT_SESSIONS=2

# STT confidence filter (Heard). Word keep floor is Accuracy T (DEFAULT_THRESHOLD).
STT_CONFIDENCE_FILTER=true
STT_SEQUENCE_CONFIDENCE_MIN=0.50
# Moonshine Tiny softmax → slider scale (lab 2026-08-14; do not treat raw P as T)
STT_DECODER_PROB_GAMMA=0.12
# STT_MAX_NEW_TOKENS=64
# STT_PARTIAL_MAX_OVERGEN_RATIO=2.0
# Ayah-constrained Heard recovery (agglutination split + in-vocab revive)
STT_AYAH_LEXICON_RECOVERY=true
STT_INVOCAB_FLOOR=0.55

# Frontend (Vite)
# Leave empty when using Vite proxy or nginx same-origin proxy.
# VITE_API_BASE_URL=http://localhost:8000
# VITE_PROXY_TARGET=http://localhost:8000

# Client-side microphone denoise (see specs/client-noise-suppression-spec.md)
# VITE_AUDIO_DENOISE=dtln          # off | native | dtln | fastenhancer
# VITE_AUDIO_DENOISE_FALLBACK=native
# VITE_AUDIO_BYPASS_UNTIL_READY=true
# VITE_AUDIO_NOISE_DETECT=false
